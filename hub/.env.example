# Copy this file to .env and fill it in. Keep .env private: it holds your account's password.
# (Only for the Compose setup. The all-in-one image uses its setup page instead.)

# The NAS user the hub runs as, which must be able to write the data folder. Over SSH, `id` shows them.
PUID=1000
PGID=1000

# The address family members use, exactly as typed in a browser.
PUBLIC_URL=https://yourname.ddns.net:8443

# Your account, to sign in, link homes and invite family. Family members get their own accounts
# through invite links. Changing the password here and restarting resets a forgotten one.
OWNER_NAME=Your name
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=
